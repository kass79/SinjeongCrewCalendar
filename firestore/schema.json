{
  "$comment": "신정승무 캘린더 Firestore 컬렉션 구조. {} 는 문서 ID 패턴.",
  "collections": {
    "users": {
      "doc": "{uid}",
      "fields": {
        "name": "string — 실명 (동료 화면 표시)",
        "email": "string",
        "role": "string — DRIVER_MAIN | CONDUCTOR | DRIVER_BRANCH | STANDBY_DRIVER | STANDBY_CONDUCTOR | OPERATION",
        "patternId": "string|null — patterns/{id} 참조",
        "patternOffset": "number — 순환 시작 오프셋(교번표의 내 줄)",
        "visibleToOthers": "boolean — 동료 화면 공개",
        "fcmToken": "string|null",
        "googleCalendarId": "string|null — 양방향 동기화 대상",
        "annualLeaveRemaining": "number",
        "promotedLeaveRemaining": "number",
        "createdAt": "timestamp",
        "isAdmin": "boolean — 근무표 업로드/패턴 편집 권한"
      }
    },
    "patterns": {
      "doc": "{patternId}",
      "fields": {
        "name": "string — 본선기관사 / 차장 / 지선 / 대기조 ...",
        "role": "string",
        "sequence": "array<string> — 순환 근무코드 (예 29칸: ['7','11','~','휴3',...])",
        "anchorDate": "string — yyyy-MM-dd, sequence[0] 이 배정된 기준일",
        "revision": "string — 시각표/근무표 개정 표기 (예 '26.5.18')",
        "createdBy": "string uid"
      }
    },
    "dias": {
      "$comment": "시각표(PDF) 데이터. 개정마다 revision 필드로 구분",
      "doc": "{diaId}  예: wd-14 / sat-3 / hol-3 / night-44-wd_sat / stby-6 / br-13",
      "fields": {
        "number": "number — 교번 숫자",
        "dayKind": "string — WEEKDAY | SATURDAY | HOLIDAY",
        "nightVariant": "string|null — WD_WD | WD_SAT | SAT_HOL | HOL_HOL | HOL_WD",
        "isNight": "boolean — 33~51",
        "isStandby": "boolean — 대기조",
        "isBranch": "boolean — 지선",
        "signOn": "string HH:mm — 출근",
        "signOff": "string HH:mm — 종료",
        "signOffNextDay": "boolean",
        "legs": [
          {
            "start": "string HH:mm",
            "end": "string HH:mm",
            "endNextDay": "boolean",
            "fromStation": "string — 신정/신도림/군자/홍대입구/성수 ...",
            "toStation": "string",
            "trainNo": "string|null",
            "kind": "string — DRIVE | BREAK | DEADHEAD | STANDBY"
          }
        ],
        "revision": "string — 예 '25.03.04'"
      }
    },
    "schedules": {
      "$comment": "확정 배정 오버라이드. 패턴 계산값과 다를 때만 문서 생성 → 읽기량 최소화",
      "doc": "{uid}_{yyyy-MM-dd}",
      "fields": {
        "uid": "string",
        "date": "string yyyy-MM-dd",
        "dutyRaw": "string — '14' | '휴3' | '대2' | '지13' | '~' | '주' | '연차' ...",
        "memo": "string",
        "source": "string — PATTERN | ROSTER_UPLOAD | MANUAL",
        "originalDutyRaw": "string|null",
        "updatedAt": "timestamp"
      }
    },
    "holidays": {
      "$comment": "공휴일/절기 (달력 표기 + dayKind 판정)",
      "doc": "{yyyy-MM-dd}",
      "fields": {
        "name": "string — 제헌절/소서/초복 ...",
        "isPublicHoliday": "boolean — true면 휴일 다이아 적용"
      }
    }
  }
}
