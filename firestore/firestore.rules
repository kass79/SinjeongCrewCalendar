rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── 사용자 ─────────────────────────────────────────────
    match /users/{uid} {
      // 동료 화면: 로그인한 승무원끼리 프로필 조회 가능
      allow read: if signedIn();
      allow create: if isSelf(uid);
      // 본인 수정 가능. isAdmin 필드는 본인이 못 올림
      allow update: if isSelf(uid)
        && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']));
      allow delete: if isSelf(uid) || isAdmin();
    }

    // ── 패턴/다이아/공휴일: 전체 읽기, 관리자만 쓰기 ─────────
    match /patterns/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /dias/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /holidays/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // ── 확정 배정 ──────────────────────────────────────────
    match /schedules/{docId} {
      // 공개 설정한 동료의 근무는 서로 조회 가능
      allow read: if signedIn() && (
        resource == null
        || resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/users/$(resource.data.uid)).data.visibleToOthers == true
      );
      // 본인 문서만 쓰기 (docId가 "{uid}_{date}" 규약 준수해야 함)
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && docId == request.resource.data.uid + '_' + request.resource.data.date;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      // 관리자 근무표 일괄 업로드
      allow write: if isAdmin();
    }
  }
}
