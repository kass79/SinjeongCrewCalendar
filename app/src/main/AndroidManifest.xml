<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 안전앱(슬기로운 승무생활) 실행 감지용 — Android 11+ 패키지 가시성 -->
    <queries>
        <package android:name="com.sinjeong.safety" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 구글 캘린더 동기화는 Calendar REST API(인터넷)로 하며 CalendarContract를 쓰지 않으므로
         READ_CALENDAR/WRITE_CALENDAR는 필요 없습니다. VIBRATE도 호출부 0건이라 제거(v1.6.18). -->
    <!-- 출근 1시간 전 브리핑: 정확 알람(12~13 기본허용, 14+는 setWindow 폴백) + 부팅 후 재등록 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 편승 알람을 잠금화면 위 전체화면으로 띄운다(v1.6.32). 14+는 사용자가 끌 수 있고,
         꺼져 있으면 heads-up으로 낮아질 뿐 소리·진동(FLAG_INSISTENT)은 그대로 울린다. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".SinjeongApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SinjeongCrew"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 편승 알람 전체화면. 잠금화면 위에 뜨고 최근앱 목록엔 남지 않는다.
             showWhenLocked/turnScreenOn은 코드에서도 켠다(API 26 대응) -->
        <activity
            android:name=".widget.AlarmRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SinjeongCrew" />

        <!-- 오늘/내일 근무 홈 위젯 -->
        <receiver
            android:name=".widget.DutyWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duty_widget_info" />
        </receiver>

        <!-- 출근 1시간 전 브리핑 알람 + 부팅 재등록 (보호된 시스템 브로드캐스트는 exported=false로도 수신).
             SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED도 여기서 받는다 — 사용자가 "알람 및 리마인더"를
             켜는 순간 브리핑과 편승 예약을 정확 알람으로 다시 건다(권한을 끌 때 시스템이 지워 버리므로). -->
        <receiver
            android:name=".widget.BriefingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 편승 알람(사용자가 상세시트에서 켠 그 날짜 1회성). 부팅 재등록은 BriefingReceiver가 겸한다 -->
        <receiver
            android:name=".widget.DeadheadReceiver"
            android:exported="false" />

        <!-- FCM(CrewMessagingService + default_notification_channel_id) 제거(v1.6.33):
             토큰을 저장하는 곳이 없어 푸시를 보낼 방법 자체가 없었는데 SDK만 기기 식별자를
             구글로 보내고 있었다. 알림은 전부 기기에서 직접 예약한다(브리핑·편승 알람). -->

        <!-- 근무표 이미지 공유용 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager 기본 자동초기화 제거 — SinjeongApp(Configuration.Provider, HiltWorkerFactory)이 담당 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
