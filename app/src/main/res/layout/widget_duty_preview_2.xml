<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 고르기 화면 previewLayout 전용(2x1) — 실제 위젯은 Glance(DutyWidget)라 XML이 없다.
  DutyWidget.Compact2 의 모습(오늘 근무 크게 + 시각 한 줄)을 정적으로 흉내 낸다:
  근무 19sp / 아래 줄 10.5sp, 칸 전체를 근무색으로 칠한다.
  근무색은 프레임워크 테마가 아니라 util/DutyPalette 의 고정 라이트 톤이므로
  여기서도 같은 값(휴무 #FFF0EC / #B3271E)을 그대로 적는다 — 실제 렌더와 같아야 한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_preview_card"
    android:backgroundTint="#FFF0EC"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="휴5"
        android:textSize="19sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:textColor="#B3271E" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="내일 출근 7:47"
        android:textSize="10.5sp"
        android:maxLines="1"
        android:textColor="#B3271E" />
</LinearLayout>
